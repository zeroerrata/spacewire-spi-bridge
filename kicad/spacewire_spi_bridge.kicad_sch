	(text "Pmod 2A: 1 CS# 2 MOSI 3 MISO 4 SCK 5 GND 6 VCC\n7 IRQ# 8 RESET# 9 IRQ2# 10 nc 11 GND 12 VCC\n(Pmod 1-6 on the odd pads, 7-12 on the even pads)\n33 R source terminations (MISO, IRQ) sit at the FPGA;\nthe host adds series R on SCK / MOSI / CS#.\nHost cable <= 10 cm at 80 MHz."
		(exclude_from_sim no)
		(at 111.76 199.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cf2ee394-228f-4e31-8fe8-f6279a779351")
	)
	(text "MISO timing (decisions, feasibility): MISO is\nlaunched on the sampling edge; reads above 40 MHz\nneed a host with a MISO sample delay, or a host\nhold time below the FPGA's minimum tCO."
		(exclude_from_sim no)
		(at 111.76 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c8c25014-712b-481d-9bfe-ba67b0a9b1f1")
	)
